# Frontend Environment Configuration Template
# Salin file ini menjadi .env.local dan isi nilainya

# URL backend API (tanpa trailing slash)
# Development : http://localhost:8080/api/v1
# Production  : https://motion-backend.azurewebsites.net/api/v1
#
# Di Vercel: set variabel ini di Dashboard → Project → Settings → Environment Variables
# Di GitHub Actions: variabel ini di-inject otomatis via `vercel pull`
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
