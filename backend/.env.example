# Motion Backend Environment Configuration Template
# Copy file ini ke .env dan isi dengan nilai yang sesuai.
SERVER_PORT=8080
SERVER_ENV=development

# Database Configuration (PostgreSQL - Supabase)
DB_HOST=your_supabase_db_host.supabase.co
DB_PORT=5432
DB_USER=postgres.your_supabase_project_id
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres

# JWT Configuration
# WAJIB: Minimal 64 karakter. Generate: openssl rand -hex 64
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long_hex_or_random
JWT_EXPIRATION=24h

# Kunci Enkripsi Database (SaaS Hardening)
# WAJIB: Minimal 32 karakter untuk AES-256. Jika kosong, fallback ke JWT_SECRET (warning).
DB_ENCRYPTION_KEY=your_super_secret_db_encryption_key_minimum_32_characters_long

# Google OAuth Configuration (kosong = Sandbox Mock Mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=

# OpenRouter AI Configuration
# Model default (gratis): meta-llama/llama-3.3-70b-instruct:free
# CATATAN: Model Hermes 3 (nousresearch/hermes-3-llama-3.1-70b) BERBAYAR di OpenRouter.
# Verifikasi ketersediaan di: https://openrouter.ai/models?q=hermes
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Google Gemini API Configuration (Official direct connection)
# Model yang tersedia: gemini-2.0-flash (cepat), gemini-2.5-pro (pintar)
# CATATAN: gemini-3.5-flash TIDAK ada — gunakan gemini-2.0-flash atau gemini-2.5-pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq AI Configuration (Primary Brain - Gratis & Cepat)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Weather Configuration
WEATHER_API_KEY=your_weather_api_key_here

# WeLearn Configuration (Penyaringan Semester Berjalan)
# Contoh format: 2025/2026_2 (Tahun Akademik 2025/2026, Semester 2)
# Biarkan kosong untuk sync semua mata kuliah tanpa filter semester.
ACTIVE_SEMESTER_PREFIX=2025/2026_2

# Hermes Agent Internal Secret
# Digunakan oleh MCP Server (Hermes Agent) untuk memanggil /api/internal/ endpoint
# tanpa JWT user — HANYA valid dari dalam Docker network. Jangan expose ke publik!
# Generate: openssl rand -hex 32
# Biarkan kosong untuk menonaktifkan Internal API.
HERMES_INTERNAL_SECRET=

# Admin Credentials (Seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password_here

# Sentry Error Tracking (Optional)
SENTRY_DSN=your_sentry_dsn_here

# SMTP Mail Configuration (Verifikasi Akun & Reset Password)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=


